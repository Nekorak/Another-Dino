{
  "name": "another-dino",
  "productName": "Another Dino",
  "version": "1.0.0",
  "description": "3D voxel pixel-art endless runner inspired by the Chrome dino",
  "author": "Nekorak",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "desktopName": "another-dino.desktop",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --publish never",
    "android:prepare": "npm run build && cap add android && node scripts/android-setup.mjs && cap sync android",
    "android:apk": "npm run android:prepare && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.nekorak.anotherdino",
    "productName": "Another Dino",
    "artifactName": "Another-Dino-${os}-${arch}.${ext}",
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Another-Dino-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.arcade-games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nekorak",
        "repo": "Another-Dino"
      }
    ]
  }
}
